<?xml version="1.0" encoding="utf-8"?>
<!-- Android exposes the middle 72dp of a 108dp adaptive layer. The 13%
     relative insets show the selected large mascot with a small clear gap
     around antennae, paper and shoes, while red fills the launcher mask.
     Relative dimensions preserve this composition at every launcher size. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="13%">
    <bitmap android:src="@drawable/workflow_pro_icon" android:gravity="fill" />
</inset>
