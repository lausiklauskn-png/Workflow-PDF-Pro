{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workflow PDF Pro",
  "mainBinaryName": "workflow-pdf-pro",
  "version": "1.0.1",
  "identifier": "de.familyprojekt.workflowpdf.pro",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node tools/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Workflow PDF Pro",
    "shortDescription": "Formulare einlesen, Felder setzen, als PDF ausgeben",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English",
          "Russian",
          "Arabic"
        ],
        "installerHooks": "../installer/hooks.nsh"
      }
    },
    "copyright": "Workflow PDF Pro",
    "category": "Productivity"
  }
}
