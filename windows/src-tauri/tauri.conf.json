{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workflow PDF Pro",
  "mainBinaryName": "workflow-pdf-pro",
  "version": "1.0.8",
  "identifier": "de.familyprojekt.workflowpdf.pro",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node tools/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2 https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2/",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https: wss:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: data: https:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/lausiklauskn-png/Workflow-PDF-Pro/releases/download/windows-updates/latest.json"],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Workflow PDF Pro",
    "shortDescription": "Formulare einlesen, Felder setzen, als PDF ausgeben",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English",
          "Russian",
          "Arabic"
        ],
        "installerHooks": "../installer/hooks.nsh"
      }
    },
    "copyright": "Workflow PDF Pro",
    "category": "Productivity"
  }
}

